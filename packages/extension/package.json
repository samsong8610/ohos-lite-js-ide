{
  "name": "ohos-lite-js-ide",
  "displayName": "OpenHarmony Lite JS IDE",
  "description": "Develop, deploy and debug ArkUI.Lite (JS) applications for OpenHarmony small-system devices",
  "version": "0.1.0",
  "publisher": "samsong8610",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://atomgit.com/ohos-lite-js-ide/ohos-lite-js-ide.git"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "OpenHarmony",
    "ArkUI",
    "HML",
    "JerryScript",
    "hdc"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:**/src/main/config.json",
    "onLanguage:hml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "OpenHarmony Lite JS",
      "properties": {
        "ohjs.tools.hdcPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%config.tools.hdcPath%"
        },
        "ohjs.device.profile": {
          "type": "string",
          "default": "2k0300-1024x768",
          "scope": "resource",
          "description": "%config.device.profile%"
        },
        "ohjs.advanced.outputEncoding": {
          "type": "string",
          "enum": [
            "auto",
            "utf8",
            "gbk"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "%config.advanced.outputEncoding%"
        },
        "ohjs.device.profileOverrides": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "%config.device.profileOverrides%"
        },
        "ohjs.device.display": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "scope": "resource",
          "description": "%config.device.display%"
        },
        "ohjs.sdkVersion": {
          "type": "string",
          "enum": [
            "5.0.3",
            "6.1-lts"
          ],
          "enumDescriptions": [
            "%config.sdkVersion.503%",
            "%config.sdkVersion.61%"
          ],
          "default": "5.0.3",
          "scope": "resource",
          "description": "%config.sdkVersion%"
        },
        "ohjs.lang.rules": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "enum": [
              "error",
              "warning",
              "information",
              "hint",
              "off"
            ]
          },
          "markdownDescription": "%config.lang.rules%",
          "propertyNames": {
            "enum": [
              "hml/syntax",
              "hml/unknown-component",
              "hml/component-disabled-by-feature",
              "hml/unknown-attribute",
              "hml/attribute-disabled-by-feature",
              "hml/doc-only-attribute",
              "hml/unknown-event",
              "hml/doc-only-event",
              "hml/unknown-event-modifier",
              "hml/invalid-child",
              "hml/for-with-if",
              "hml/empty-event-handler",
              "hml/conditional-component",
              "css/unsupported-selector",
              "css/unsupported-pseudo",
              "hml/es6-in-expression",
              "js/es6-syntax",
              "prj/missing-app-module",
              "prj/device-type",
              "prj/missing-pages",
              "prj/first-page-not-index",
              "prj/page-file-missing",
              "prj/page-not-registered",
              "i18n/missing-key",
              "i18n/missing-translation"
            ]
          }
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.ohjs/device-profiles/*.json",
          "**/device-profiles/*.json"
        ],
        "url": "./dist/schemas/device-profile.schema.json"
      }
    ],
    "commands": [
      {
        "command": "ohjs.device.refresh",
        "title": "%command.device.refresh%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      }
    ],
    "languages": [
      {
        "id": "hml",
        "aliases": [
          "HML",
          "hml"
        ],
        "extensions": [
          ".hml"
        ],
        "configuration": "./language-configuration.hml.json"
      }
    ],
    "grammars": [
      {
        "language": "hml",
        "scopeName": "text.html.hml",
        "path": "./syntaxes/hml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.hml": "javascript",
          "source.js.embedded.hml": "javascript"
        }
      }
    ]
  },
  "scripts": {
    "bundle": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:integration": "pnpm run bundle && tsc -p test/integration/tsconfig.json && node out-test/runTest.js",
    "package": "vsce package --no-dependencies",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/hml.tmLanguage.json -g test/grammar/source.js.stub.tmLanguage.json \"test/grammar/*.test.hml\""
  },
  "dependencies": {
    "@ohjs/core": "workspace:*",
    "@ohjs/language-server": "workspace:*",
    "@ohjs/schemas": "workspace:*",
    "@ohjs/transport-hdc": "workspace:*",
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@ohjs/test-kit": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.11",
    "mocha": "^11.7.4",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}

{
  "name": "ohos-lite-js-ide",
  "displayName": "OpenHarmony Lite JS IDE",
  "description": "Develop, deploy and debug ArkUI.Lite (JS) applications for OpenHarmony small-system devices",
  "version": "0.1.0",
  "publisher": "samsong8610",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://atomgit.com/ohos-lite-js-ide/ohos-lite-js-ide.git"
  },
  "engines": {
    "vscode": "^1.143.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "OpenHarmony",
    "ArkUI",
    "HML",
    "JerryScript",
    "hdc"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:**/src/main/config.json",
    "onLanguage:hml",
    "onDebugResolve:ohjs",
    "onCommand:ohjs.project.new"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "OpenHarmony Lite JS",
      "properties": {
        "ohjs.tools.hdcPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%config.tools.hdcPath%"
        },
        "ohjs.tools.hdcServer": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%config.tools.hdcServer%",
          "pattern": "^$|^([0-9.\\[\\]:a-fA-F]+:)?\\d{1,5}$"
        },
        "ohjs.tools.hdcOhVersion": {
          "type": "string",
          "enum": [
            "",
            "5.0.3",
            "6.1-lts"
          ],
          "enumDescriptions": [
            "%config.tools.hdcOhVersion.auto%",
            "%config.tools.hdcOhVersion.503%",
            "%config.tools.hdcOhVersion.61%"
          ],
          "default": "",
          "scope": "machine-overridable",
          "description": "%config.tools.hdcOhVersion%"
        },
        "ohjs.device.targetKey": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "%config.device.targetKey%"
        },
        "ohjs.build.backend": {
          "type": "string",
          "enum": [
            "auto",
            "fixture",
            "ace-loader"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "%config.build.backend%"
        },
        "ohjs.build.aceLoaderPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "%config.build.aceLoaderPath%"
        },
        "ohjs.device.profile": {
          "type": "string",
          "default": "2k0300-1024x768",
          "scope": "resource",
          "description": "%config.device.profile%"
        },
        "ohjs.advanced.outputEncoding": {
          "type": "string",
          "enum": [
            "auto",
            "utf8",
            "gbk"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "%config.advanced.outputEncoding%"
        },
        "ohjs.device.profileOverrides": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "%config.device.profileOverrides%"
        },
        "ohjs.device.display": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "scope": "resource",
          "description": "%config.device.display%"
        },
        "ohjs.sdkVersion": {
          "type": "string",
          "enum": [
            "5.0.3",
            "6.1-lts"
          ],
          "enumDescriptions": [
            "%config.sdkVersion.503%",
            "%config.sdkVersion.61%"
          ],
          "default": "5.0.3",
          "scope": "resource",
          "description": "%config.sdkVersion%"
        },
        "ohjs.lang.rules": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "enum": [
              "error",
              "warning",
              "information",
              "hint",
              "off"
            ]
          },
          "markdownDescription": "%config.lang.rules%",
          "propertyNames": {
            "enum": [
              "hml/syntax",
              "hml/unknown-component",
              "hml/component-disabled-by-feature",
              "hml/unknown-attribute",
              "hml/attribute-disabled-by-feature",
              "hml/doc-only-attribute",
              "hml/unknown-event",
              "hml/doc-only-event",
              "hml/unknown-event-modifier",
              "hml/invalid-child",
              "hml/for-with-if",
              "hml/empty-event-handler",
              "hml/conditional-component",
              "css/unsupported-selector",
              "css/unsupported-pseudo",
              "hml/es6-in-expression",
              "hml/expression-rewrite",
              "js/es6-syntax",
              "js/es6-untranspilable",
              "js/unsupported-builtin",
              "js/unknown-system-module",
              "prj/missing-app-module",
              "prj/device-type",
              "prj/missing-pages",
              "prj/first-page-not-index",
              "prj/page-file-missing",
              "prj/page-not-registered",
              "i18n/missing-key",
              "i18n/missing-translation",
              "prj/page-name-conflict",
              "res/image-format",
              "feature/rotation-disabled"
            ]
          }
        },
        "ohjs.diagnostics.transpilableSyntax": {
          "type": "string",
          "enum": [
            "warning",
            "error",
            "off"
          ],
          "default": "warning",
          "scope": "resource",
          "markdownDescription": "%config.diagnostics.transpilableSyntax%"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/src/main/config.json",
        "url": "./schemas/config.schema.json"
      },
      {
        "fileMatch": "**/src/main/js/*/i18n/*.json",
        "url": "./schemas/i18n.schema.json"
      }
    ],
    "commands": [
      {
        "command": "ohjs.device.refresh",
        "title": "%command.device.refresh%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      },
      {
        "command": "ohjs.project.new",
        "title": "%command.project.new%",
        "category": "OHJS"
      },
      {
        "command": "ohjs.project.build",
        "title": "%command.project.build%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      },
      {
        "command": "ohjs.app.deploy",
        "title": "%command.app.deploy%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      },
      {
        "command": "ohjs.app.launch",
        "title": "%command.app.launch%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      },
      {
        "command": "ohjs.app.stop",
        "title": "%command.app.stop%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      },
      {
        "command": "ohjs.logs.start",
        "title": "%command.logs.start%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      },
      {
        "command": "ohjs.logs.stop",
        "title": "%command.logs.stop%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      },
      {
        "command": "ohjs.app.run",
        "title": "%command.app.run%",
        "category": "OHJS",
        "enablement": "ohjs.isProject"
      }
    ],
    "languages": [
      {
        "id": "hml",
        "aliases": [
          "HML",
          "hml"
        ],
        "extensions": [
          ".hml"
        ],
        "configuration": "./language-configuration.hml.json"
      }
    ],
    "debuggers": [
      {
        "type": "ohjs",
        "label": "%debuggers.ohjs.label%",
        "program": "./dist/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "bundle": {
                "type": "string",
                "description": "%debuggers.ohjs.bundle%"
              },
              "ability": {
                "type": "string",
                "description": "%debuggers.ohjs.ability%"
              },
              "localPort": {
                "type": "number",
                "default": 19001,
                "description": "%debuggers.ohjs.localPort%"
              },
              "preDeploy": {
                "type": "boolean",
                "default": true,
                "description": "%debuggers.ohjs.preDeploy%"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ohjs",
            "request": "launch",
            "name": "%debuggers.ohjs.initialName%",
            "preDeploy": true,
            "localPort": 19001,
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debuggers.ohjs.snippetLabel%",
            "description": "%debuggers.ohjs.snippetDesc%",
            "body": {
              "type": "ohjs",
              "request": "launch",
              "name": "${1:Debug OHJS App}",
              "preDeploy": true,
              "localPort": 19001,
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "hml",
        "scopeName": "text.html.hml",
        "path": "./syntaxes/hml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.hml": "javascript",
          "source.js.embedded.hml": "javascript"
        }
      },
      {
        "scopeName": "source.css.ohlite.injection",
        "path": "./syntaxes/css-ohlite.injection.json",
        "injectTo": [
          "source.css",
          "source.css.less",
          "source.css.scss"
        ]
      }
    ]
  },
  "scripts": {
    "bundle": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:integration": "pnpm run bundle && tsc -p test/integration/tsconfig.json && node out-test/runTest.js",
    "package": "vsce package --no-dependencies",
    "test:grammar": "vscode-tmgrammar-test -g syntaxes/hml.tmLanguage.json -g test/grammar/source.js.stub.tmLanguage.json -g test/grammar/source.css.stub.tmLanguage.json \"test/grammar/*.test.hml\" \"test/grammar/*.test.css\""
  },
  "dependencies": {
    "@ohjs/core": "workspace:*",
    "@ohjs/language-server": "workspace:*",
    "@ohjs/schemas": "workspace:*",
    "@ohjs/build": "workspace:*",
    "@ohjs/transport-hdc": "workspace:*",
    "@ohjs/debug-adapter": "workspace:*",
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@ohjs/test-kit": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.140.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.11",
    "mocha": "^11.7.4",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}

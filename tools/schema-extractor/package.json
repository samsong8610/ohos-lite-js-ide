{
  "name": "@ohjs/schema-extractor",
  "version": "0.1.0",
  "private": true,
  "description": "Extracts versioned component schemas from OpenHarmony sources",
  "license": "Apache-2.0",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "files": [
    "out",
    "sources.json"
  ],
  "dependencies": {
    "@ohjs/schemas": "workspace:*"
  },
  "scripts": {
    "generate": "tsc -b && node out/cli.js generate",
    "check": "tsc -b && node out/cli.js check"
  }
}
